<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Searchlight.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Searchlight.Converters"
    xmlns:controls="using:Searchlight.Controls"
    xmlns:models="using:Searchlight.Models"
    xmlns:viewmodels="using:Searchlight.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:StringOrDashConverter x:Key="StringOrDash" />
        <conv:FriendlyDateConverter x:Key="FriendlyDate" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region). The default system title bar is removed
             via ExtendsContentIntoTitleBar in MainWindow, so this dark strip fills
             that space and carries the single app label. Right padding reserves room
             for the min/max/close caption buttons that overlay the top-right. -->
        <Grid Grid.Row="0" Height="40" Padding="16,0,150,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- ASSUMPTION: only the label region is draggable; title bar actions
                 must remain outside SetTitleBar's non-client input region. -->
            <Grid x:Name="AppTitleBar" Background="Transparent" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- UAC shield: shown only when the app runs elevated, like Windows Terminal.
                     Placed at the far left (before the app icon), drawn white to stay subtle.
                     OneTime x:Bind — elevation is fixed for the process lifetime. -->
                <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="White"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Running as administrator"
                          Visibility="{x:Bind IsElevated, Converter={StaticResource BoolToVis}}" />
                <Image Grid.Column="1" Source="{x:Bind AppIconSource}" Width="18" Height="18"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind AppDisplayName}" />
                    <Run Text="   Historical Session Viewer"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         FontWeight="Normal" />
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Click="OnSettingsClick"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button x:Name="InformationButton" Click="OnInformationClick"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        AutomationProperties.Name="Information" ToolTipService.ToolTip="Information">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasPersistenceNotice, Mode=OneWay}"
                 Title="Shared data needs attention"
                 Message="{x:Bind ViewModel.PersistenceNotice, Mode=OneWay}" />

        <Grid x:Name="ApplicationPane" Grid.Row="2" Grid.RowSpan="3"
              Visibility="Collapsed" KeyboardAcceleratorPlacementMode="Hidden">
            <!-- ASSUMPTION: Escape stays active, but the container must not generate a key-tip tooltip. -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnPaneEscape" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="16,12,16,16">
                <Button x:Name="BackButton" Click="OnBackClick"
                        AutomationProperties.Name="Back to sessions"
                        ToolTipService.ToolTip="Back to sessions (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PaneTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>
            <ScrollViewer x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Margin="24,0,24,32">
                    <TextBlock Text="Changes are saved automatically."
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8" Margin="0,0,0,16"
                                Visibility="{x:Bind ShowStartupSetting, Converter={StaticResource BoolToVis}}">
                        <ToggleSwitch Header="Start Searchlight when I sign in"
                                      AutomationProperties.Name="Start Searchlight when I sign in"
                                      IsOn="{x:Bind Startup.IsEnabled, Mode=OneWay}"
                                      IsEnabled="{x:Bind Startup.CanChange, Mode=OneWay}"
                                      Toggled="OnStartupToggled" />
                        <TextBlock Text="Controls auto-start for this Production installation only."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Startup.Message, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="Open Windows startup settings"
                                         NavigateUri="ms-settings:startupapps"
                                         HorizontalAlignment="Left" Padding="0" />
                    </StackPanel>
                    <TextBlock Text="Reuse my existing terminal window"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="When on, resuming a session opens a new tab in your most-recently-used Windows Terminal window (a new one is created only if none is open). When off, each resume opens its own new window." />
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Reuse my existing terminal window"
                                  OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.Settings.Current.UseSharedTerminalWindow, Mode=TwoWay}" />

                    <!-- Elevation opt-in. Needed when the user's main Terminal
                         runs as Admin: matching integrity level lets `wt -w`
                         reuse that window. Flipping on relaunches elevated. -->
                    <TextBlock Text="Run as administrator"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Turn on if your main Terminal runs as Administrator. The app restarts elevated (one UAC prompt) so resumed tabs can share your Admin Terminal window. Turning off applies on the next launch." />
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Run as administrator"
                                  OnContent="On" OffContent="Off"
                                  IsEnabled="{x:Bind CanChangeElevation}"
                                  IsOn="{x:Bind ViewModel.Settings.Current.RunElevated, Mode=TwoWay}" />
                    <TextBlock Text="Administrator mode is disabled for this launch. Your saved preference is unchanged."
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasElevationOverride, Converter={StaticResource BoolToVis}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Margin="0,16,0,16" Padding="16"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Resume command" Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="Choose the command run inside the terminal. Terminal reuse and administrator settings above still apply."
                                       TextWrapping="Wrap" />
                            <ToggleSwitch Header="Resume with --yolo" MinWidth="0"
                                          AutomationProperties.Name="Resume with --yolo"
                                          IsEnabled="{x:Bind ViewModel.IsDefaultResumeCommand, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.Settings.Current.AppendYolo, Mode=TwoWay}" />
                            <TextBlock Text="For the default command, --yolo grants all tool approvals automatically. In custom mode, include any desired flags in your template yourself."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch Header="Use a custom command" MinWidth="0"
                                          AutomationProperties.Name="Use a custom resume command"
                                          IsOn="{x:Bind ViewModel.Settings.Current.UseCustomResumeCommand, Mode=TwoWay}" />
                            <TextBox Header="Custom command template" FontFamily="Consolas"
                                     AutomationProperties.Name="Custom resume command template"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     IsEnabled="{x:Bind ViewModel.Settings.Current.UseCustomResumeCommand, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.Settings.Current.CustomResumeCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Use {sessionId} for the selected session ID. Enter a single-line cmd.exe command (up to 3000 characters). Nothing runs until you choose Resume."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <InfoBar Severity="Warning" IsClosable="False"
                                     IsOpen="{x:Bind ViewModel.HasResumeCommandError, Mode=OneWay}"
                                     Title="Resume command needs attention"
                                     Message="{x:Bind ViewModel.ResumeCommandValidationMessage, Mode=OneWay}" />
                            <TextBlock Text="Command preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Padding="12" CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           AutomationProperties.Name="Resume command preview"
                                           Text="{x:Bind ViewModel.ResumeCommandPreview, Mode=OneWay}" />
                            </Border>
                            <TextBlock Text="The all-zero GUID is a preview placeholder; the actual session ID is inserted when resuming. Custom commands run with Searchlight's current permissions."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Restore default command"
                                    Command="{x:Bind ViewModel.ResetResumeCommandCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Session-list hide filters. Each description must stand
                         on its own: a setting that explains itself in terms of
                         another setting can't be read or reasoned about
                         independently, so the shared facts (excluded from
                         search; pinned/renamed always visible) are stated in
                         full on both rather than cross-referenced. -->
                    <TextBlock Text="Hide empty sessions"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Hides sessions that never held a conversation — the folders Copilot creates whenever a project is opened. They contain no messages, so nothing is lost. Hidden sessions are excluded from search; pinned and renamed sessions always stay visible." />
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Hide empty sessions"
                                  OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.Settings.Current.HideEmptySessions, Mode=TwoWay}" />

                    <TextBlock Text="Hide unnamed sessions"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Hides sessions that show only a UUID because they were never named. Some of these do hold real conversations. Hidden sessions are excluded from search; pinned and renamed sessions always stay visible." />
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Hide unnamed sessions"
                                  OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.Settings.Current.HideUnnamedSessions, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="InformationPane" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Margin="24,0,24,32">
                    <TextBlock Text="{x:Bind AppDisplayName}" Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind AppVersionText}" />
                        <Run Text=" - " />
                        <Run Text="{x:Bind AppChannelText}" />
                    </TextBlock>
                    <TextBlock Text="Historical Session Viewer for GitHub Copilot"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Browse, search, and resume your local GitHub Copilot sessions from one place."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Getting started" Margin="0,16,0,0"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Search by session name, ID, folder, branch, or prompt. Select a session to see its native Copilot metadata, agent tasks, and checkpoints."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Open the Agent tasks tab to read a fresh snapshot of that session's tasks. Use its Refresh button to update the snapshot."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Pin important sessions, give them recognizable names, and keep session notes. Pinned and renamed sessions stay visible even when hide filters are enabled."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Double-click a session or choose Resume to continue it in a terminal. Settings controls terminal reuse, administrator mode, resume approvals, and session visibility."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Your data" Margin="0,16,0,0"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ScrollViewer x:Name="YourDataText"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Searchlight reads your local Copilot history from ~/.copilot without modifying it."
                                       TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind AppDataStorageText}"
                                       TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="Window and tray" Margin="0,16,0,0"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind AppWindowBehaviorText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Source Control" Margin="0,16,0,0"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <!-- ASSUMPTION: the raw URL remains clickable. -->
                    <HyperlinkButton NavigateUri="https://github.com/TimothyMothra/Searchlight-SessionViewer"
                                     HorizontalAlignment="Left" Padding="0"
                                     AutomationProperties.Name="Open the Searchlight GitHub repository">
                        <TextBlock Text="https://github.com/TimothyMothra/Searchlight-SessionViewer"
                                   TextWrapping="Wrap" />
                    </HyperlinkButton>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Search + refresh. Both action buttons use the app-wide "<glyph> <label>"
             pattern (see Pin/Rename/Resume) so no control is icon-only. -->
        <Grid x:Name="SessionSearchBar" Grid.Row="2" Padding="16,4,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Loaded handler neutralizes the TextBox's built-in inline delete part,
                 whose bare "x" glyph carries no visible label; the Clear button below
                 replaces it. -->
            <TextBox Grid.Column="0"
                     PlaceholderText="Search name, id, folder, branch, prompt…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Loaded="OnSearchBoxLoaded"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch" />

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    Visibility="{x:Bind ViewModel.HasSearchText, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Clear the search box">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>

            <ProgressRing Grid.Column="2"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="20" Height="20"
                          VerticalAlignment="Center" />

            <Button Grid.Column="3"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Reload sessions from disk">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Body: list (left) + details (right) -->
        <Grid x:Name="SessionContent" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Session list. FlowDirection is flipped to RightToLeft so the native
                 vertical scrollbar renders on the list's LEFT edge (next to the tick
                 rail, away from the details pane). The item template root and group
                 header restore LeftToRight so their content still reads normally. -->
            <ListView Grid.Column="1"
                      x:Name="SessionList"
                      FlowDirection="RightToLeft"
                      SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                      SelectionMode="Single"
                      DoubleTapped="OnSessionDoubleTapped"
                      Padding="8,0,8,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionInfo">
                        <Grid ColumnSpacing="8" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Cwd, Converter={StaticResource StringOrDash}}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Branch, Converter={StaticResource StringOrDash}}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="•"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind UpdatedAt, Converter={StaticResource FriendlyDate}}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                <!-- Note-presence badge: outlined shape + glyph + "Notes" text
                                     (distinguished by shape, not color) so the row shows at a
                                     glance that it carries a saved note. -->
                                <Border Background="Transparent" BorderThickness="1"
                                        BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind HasNote, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE70B;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Notes" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind IsInUse, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="In use" FontSize="10"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <!-- Client badges: distinguished by SHAPE (filled vs outlined)
                                     + GLYPH + TEXT, not color alone, so they stay legible without
                                     color perception. CLI = filled + command-prompt glyph;
                                     App = outlined + apps glyph. -->
                                <Border Background="#4A5BD6"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind IsCliClient, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="10" Foreground="White" />
                                        <TextBlock Text="CLI" FontSize="10" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <Border Background="Transparent" BorderThickness="1" BorderBrush="#3AC0D4"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind IsAppClient, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="10" Foreground="#3AC0D4" />
                                        <TextBlock Text="App" FontSize="10" Foreground="#3AC0D4" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Kind}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:SessionGroup">
                                <Border Padding="4,12,4,4" FlowDirection="LeftToRight"
                                        Background="Transparent"
                                        PointerWheelChanged="OnGroupHeaderPointerWheelChanged">
                                    <TextBlock Text="{x:Bind Key}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <!-- Compact tick rail: an always-visible column of short group labels
                 that acts like a second scrollbar — clicking a tick jumps the list
                 straight to that group. Pinned to the far-left edge (col 0). -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="2,0,2,8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.SessionGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionGroup">
                            <Button Click="OnRailTickClick"
                                    Tag="{x:Bind}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,4"
                                    Margin="0,1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Key}">
                                <TextBlock Text="{x:Bind ShortKey}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Divider -->
            <Border Grid.Column="2" Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Details pane -->
            <Grid Grid.Column="3">
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.Details.HasSession, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Select a session"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Native Copilot details, agent tasks, and checkpoints appear here."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- Details content: pinned header + scrolling body -->
                <Grid Visibility="{x:Bind ViewModel.Details.HasSession, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Pinned title + Resume (stays visible while body scrolls) -->
                    <Border Grid.Row="0" Padding="20,16,20,8">
                    <controls:SessionHeaderPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Details.Session.DisplayName, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <!-- Note-presence badge: text label (not icon-only) so it reads
                                 clearly. Shown when the selected session has a saved note. -->
                            <Border Background="Transparent" BorderThickness="1"
                                    BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2" Margin="0,2,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind ViewModel.SelectedHasNote, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70B;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Has notes" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Top">
                                        <!-- Notes toggle: shows/hides the optional Notes pane. Text
                                             label (not icon-only) per the accessibility-first rule;
                                             the label reads "Show notes" / "Hide notes" to match state. -->
                                        <Button Command="{x:Bind ViewModel.ToggleNotesPaneCommand}"
                                                VerticalAlignment="Stretch"
                                                AutomationProperties.Name="Toggle notes pane"
                                                ToolTipService.ToolTip="Show or hide the notes pane">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE70B;" FontSize="14" />
                                                <TextBlock Text="{x:Bind ViewModel.NotesPaneToggleLabel, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Rename uses a TEXT label (accessibility: no icon-only
                                             affordance). Opens a small flyout with a text box editing
                                             the effective title; empty input reverts to the default. -->
                                        <Button VerticalAlignment="Stretch"
                                                ToolTipService.ToolTip="Rename this session">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                                <TextBlock Text="Rename" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout x:Name="RenameFlyout">
                                                    <StackPanel Spacing="12" MinWidth="280">
                                                        <TextBlock Text="Rename session"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBox Header="Display name"
                                                                 Text="{x:Bind ViewModel.RenameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="False" />
                                                        <TextBlock Text="Leave blank to restore the automatic name."
                                                                   TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                                                                    Click="OnRenameSaveClick" />
                                                            <Button Content="Reset to default"
                                                                    Click="OnRenameResetClick"
                                                                    IsEnabled="{x:Bind ViewModel.SelectedHasCustomName, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <!-- Pin/Unpin use a TEXT label (not an icon-only affordance) for
                                 accessibility: pin glyphs are ambiguous, so a word makes the action
                                 unmistakable. Exactly one shows, toggled by the observable
                                 SelectedIsPinned so it flips live on pin/unpin. -->
                            <Button Command="{x:Bind ViewModel.TogglePinCommand}"
                                    VerticalAlignment="Stretch"
                                    Visibility="{x:Bind ViewModel.SelectedIsPinned, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                                    <TextBlock Text="Pin" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.TogglePinCommand}"
                                    VerticalAlignment="Stretch"
                                    Visibility="{x:Bind ViewModel.SelectedIsPinned, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77A;" FontSize="14" />
                                    <TextBlock Text="Unpin" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.Details.ResumeCommand}"
                                    VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Resume" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SessionHeaderPanel>
                    </Border>

                    <TabView Grid.Row="1" Margin="20,0,20,16"
                             SelectedIndex="{x:Bind ViewModel.Details.SelectedTabIndex, Mode=TwoWay}"
                             TabWidthMode="SizeToContent" IsAddTabButtonVisible="False"
                             CanDragTabs="False" CanReorderTabs="False">
                        <TabView.Resources>
                            <!-- Compact headers retain native tab navigation and a
                                 selected underline instead of button-like action styling. -->
                            <x:Double x:Key="TabViewItemMinHeight">36</x:Double>
                            <x:Double x:Key="TabViewItemMinWidth">144</x:Double>
                        </TabView.Resources>
                        <TabView.TabStripFooter>
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </TabView.TabStripFooter>
                        <TabViewItem IsClosable="False" AutomationProperties.Name="Details">
                            <TabViewItem.Header>
                                <Grid MinWidth="112" Height="28">
                                    <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Height="3" CornerRadius="1" VerticalAlignment="Bottom"
                                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                            Visibility="{x:Bind ViewModel.Details.IsDetailsTabSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </TabViewItem.Header>
                    <ScrollViewer Padding="8,8,8,0"
                                  BorderThickness="0,1,0,0"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel Spacing="16">
                            <!-- Detail reads are asynchronous; list navigation and
                                 resume remain available while this indicator is shown. -->
                            <TextBlock Text="Loading session details..."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.Details.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.Details.SectionLoadError, Mode=OneWay}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                       Visibility="{x:Bind ViewModel.Details.SectionLoadError, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                            <TextBlock Text="Native Copilot metadata only. Missing values are shown as a dash; timestamps use local time with UTC offset."
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Details.MetadataGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:SessionMetadataGroup">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:SessionMetadataField">
                                                            <Grid ColumnSpacing="16" Padding="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="180" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <Grid Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Left">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap"
                                                                               IsTextSelectionEnabled="True" MaxLines="24" TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="1" Command="{x:Bind CopyCommand}"
                                                                            Visibility="{x:Bind CanCopy, Converter={StaticResource BoolToVis}}"
                                                                            Padding="4" MinWidth="0" VerticalAlignment="Top"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            AutomationProperties.Name="Copy session ID"
                                                                            ToolTipService.ToolTip="Copy session ID">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                                    </Button>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                    </StackPanel>
                    </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem IsClosable="False" AutomationProperties.Name="Agent tasks">
                            <TabViewItem.Header>
                                <Grid MinWidth="112" Height="28">
                                    <TextBlock Text="Agent tasks" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Height="3" CornerRadius="1" VerticalAlignment="Bottom"
                                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                            Visibility="{x:Bind ViewModel.Details.IsAgentTasksTabSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </TabViewItem.Header>
                            <!-- ASSUMPTION: only selecting this tab authorizes a todo read.
                                 Horizontal table scrolling must not unbound the vertical
                                 ListView viewport, which preserves row virtualization. -->
                            <Grid Padding="8,8,8,0" RowSpacing="4"
                                  BorderThickness="0,1,0,0"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="These are Copilot's tracked work items for this session, not tasks assigned to you. The read-only table shows each task's status and timestamps as stored. Reopen this tab or select Refresh to load the latest tasks."
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Details.Todos.CountsText, Mode=OneWay}"
                                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh"
                                            Command="{x:Bind ViewModel.Details.Todos.RefreshCommand}"
                                            AutomationProperties.Name="Refresh agent tasks" />
                                </Grid>
                                <StackPanel Grid.Row="2" Spacing="8">
                                    <TextBlock Text="Loading agent tasks..."
                                               Visibility="{x:Bind ViewModel.Details.Todos.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{x:Bind ViewModel.Details.Todos.Message, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.Details.Todos.Message, Mode=OneWay, Converter={StaticResource StringToVis}}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{x:Bind ViewModel.Details.Todos.Warning, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.Details.Todos.Warning, Mode=OneWay, Converter={StaticResource StringToVis}}"
                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="3" HorizontalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              SizeChanged="OnTaskTableViewportSizeChanged"
                                              AutomationProperties.Name="Agent task table columns">
                                <Grid x:Name="AgentTaskTable" Width="1186">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!-- Header and row widths match; the description absorbs
                                         additional viewport width without truncating text. -->
                                    <Grid Padding="8,6" ColumnSpacing="12"
                                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="0,2" />
                                                <Setter Property="MinHeight" Value="24" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind ViewModel.Details.Todos.IdHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Id}"
                                                ToolTipService.ToolTip="Sort by ID; click again to reverse" />
                                        <Button Grid.Column="1" Content="{x:Bind ViewModel.Details.Todos.TitleHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Title}"
                                                ToolTipService.ToolTip="Sort by title; click again to reverse" />
                                        <Button Grid.Column="2" Content="{x:Bind ViewModel.Details.Todos.DescriptionHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Description}"
                                                ToolTipService.ToolTip="Sort by description; click again to reverse" />
                                        <Button Grid.Column="3" Content="{x:Bind ViewModel.Details.Todos.StatusHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Status}"
                                                ToolTipService.ToolTip="Sort by status; click again to reverse" />
                                        <Button Grid.Column="4" Content="{x:Bind ViewModel.Details.Todos.CreatedHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Created}"
                                                ToolTipService.ToolTip="Sort by created date; click again to reverse" />
                                        <Button Grid.Column="5" Content="{x:Bind ViewModel.Details.Todos.UpdatedHeader, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.Details.Todos.SortCommand}"
                                                CommandParameter="{x:Bind models:SessionTodoSortColumn.Updated}"
                                                ToolTipService.ToolTip="Sort by updated date; click again to reverse" />
                                    </Grid>
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.Details.Todos.Items, Mode=OneWay}"
                                          SelectionMode="None" IsItemClickEnabled="False"
                                          AutomationProperties.Name="Session agent tasks"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SessionTodo">
                                            <Grid ColumnSpacing="12" Padding="8,6"
                                                  BorderThickness="0,0,0,1"
                                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Id, Converter={StaticResource StringOrDash}}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Description, Converter={StaticResource StringOrDash}}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind DisplayStatus}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind CreatedAt, Converter={StaticResource StringOrDash}}"
                                                           FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind UpdatedAt, Converter={StaticResource StringOrDash}}"
                                                           FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                </Grid>
                                </ScrollViewer>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem IsClosable="False" AutomationProperties.Name="Checkpoints">
                            <TabViewItem.Header>
                                <Grid MinWidth="112" Height="28">
                                    <TextBlock Text="Checkpoints" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Height="3" CornerRadius="1" VerticalAlignment="Bottom"
                                            Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                            Visibility="{x:Bind ViewModel.Details.IsCheckpointsTabSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </TabViewItem.Header>
                            <ScrollViewer Padding="8,8,8,0"
                                          BorderThickness="0,1,0,0"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Checkpoints are saved summaries of this session's progress and context. Each entry shows its number, title, and file's last-modified date/time (local time with UTC offset), newest checkpoint first."
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Loading checkpoints..."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.Details.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{x:Bind ViewModel.Details.SectionLoadError, Mode=OneWay}"
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                               Visibility="{x:Bind ViewModel.Details.SectionLoadError, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Details.Checkpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CheckpointInfo">
                                                <Grid ColumnSpacing="10" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind Number}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Title, Converter={StaticResource StringOrDash}}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource FriendlyDate}, ConverterParameter=absolute}"
                                                                   FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                                   ToolTipService.ToolTip="Checkpoint file last modified (local time)"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind FilePath, Converter={StaticResource StringOrDash}}"
                                                                   FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No checkpoints." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind ViewModel.Details.ShowNoCheckpoints, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Grid>

            <!-- Divider before the optional Notes pane (collapses with the pane). -->
            <Border Grid.Column="4" Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsNotesPaneVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- Optional Notes pane: free-form, unformatted per-session notes,
                 autosaved to a sidecar file. Its Auto column shrinks to zero width
                 when the pane is hidden (the content collapses). A plain multiline
                 TextBox with a real "Notes" heading and AutomationProperties.Name —
                 no icon-only affordance — per the accessibility-first design. -->
            <Grid Grid.Column="5" Width="320"
                  Visibility="{x:Bind ViewModel.IsNotesPaneVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2" Padding="16,16,16,8">
                    <TextBlock Text="Notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Saved automatically for this session."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBox Grid.Row="1" Margin="16,0,16,16"
                         Text="{x:Bind ViewModel.SelectedNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.Details.HasSession, Mode=OneWay}"
                         PlaceholderText="Write notes about this session…"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Session notes" />
            </Grid>
        </Grid>

        <!-- Status bar: session count (left, mirrors the list pane) + most-recent action (right, full text, right-aligned, selectable) -->
        <Border x:Name="SessionStatusBar" Grid.Row="4" Padding="16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.VisibleCount, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="of" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="sessions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <!-- Hidden-count notice. Visible only when a hide filter actually
                         removed rows, so a user who cannot find a session learns that
                         hidden rows are excluded from search rather than assuming the
                         session is gone. -->
                    <TextBlock Text="{x:Bind ViewModel.HiddenNoticeText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasHiddenSessions, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" FontStyle="Italic"
                               ToolTipService.ToolTip="Hidden by the session-list filters in Settings. Hidden sessions are also excluded from search — turn a filter off to include them." />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.Details.LastActionText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
            </Grid>
        </Border>

        <!-- Bottom-right resize grip: an oversized transparent grab target (VS Code pixelated-triangle
             style) declared after the footer Border so it renders on top of the same Row 3 cell. The
             ResizeGrip control shows the diagonal NWSE resize cursor on hover so the corner clearly
             reads as grabbable; the 28x28 transparent square makes it easy to hit without pixel-hunting,
             while the dot triangle stays visually tucked in the corner. The dot Canvas is
             IsHitTestVisible=False so only the container handles PointerPressed. -->
        <controls:ResizeGrip Grid.Row="4" x:Name="ResizeGrip"
              Width="28" Height="28"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent"
              PointerPressed="OnResizeGripPressed"
              PointerMoved="OnResizeGripMoved"
              PointerReleased="OnResizeGripReleased"
              PointerCaptureLost="OnResizeGripCaptureLost"
              ToolTipService.ToolTip="Drag to resize">
            <Canvas IsHitTestVisible="False" Width="28" Height="28">
                <!-- Bottom row (3 dots) -->
                <Rectangle Canvas.Left="15" Canvas.Top="23" Width="2.5" Height="2.5"
                           Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                <Rectangle Canvas.Left="19" Canvas.Top="23" Width="2.5" Height="2.5"
                           Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                <Rectangle Canvas.Left="23" Canvas.Top="23" Width="2.5" Height="2.5"
                           Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Middle row (2 dots) -->
                <Rectangle Canvas.Left="19" Canvas.Top="19" Width="2.5" Height="2.5"
                           Fill="{ThemeResource TextFillColorTertiaryBrush}" />
